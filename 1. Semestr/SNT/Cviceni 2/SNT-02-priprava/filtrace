
import pandas as pd
import matplotlib.pyplot as plt
m = pd.read_csv('mereni_teploty.csv')
tm = m['t']
T = m['T']
T_filtr = T.rolling(9, center=True,
min_periods=1).mean()
plt.plot(tm, T, '.', tm, T_filtr, '-')
plt.xlabel('t [s]'); plt.ylabel('T [°C]')
plt.legend(['Původní', 'Filtrovaná'])
plt.grid(True); plt.show()